{
  "name": "@nitorcreations/kysely-data-api",
  "version": "3.0.0",
  "repository": "git@github.com:NitorCreations/kysely-data-api.git",
  "type": "module",
  "module": "./dist/index.js",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "registry": "https://packages.nitor.zone/repository/npm/",
    "access": "restricted"
  },
  "license": "MIT",
  "scripts": {
    "clean": "rm -rf dist && rm -rf test/dist",
    "release": "pnpm build && pnpm changeset publish",
    "build": "pnpm clean && tsc",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "AWS_SDK_LOAD_CONFIG=1 vitest"
  },
  "devDependencies": {
    "@aws-sdk/client-rds-data": "3.1089.0",
    "@changesets/changelog-github": "0.4.8",
    "@changesets/cli": "2.31.1",
    "@tsconfig/node24": "24.0.4",
    "@types/node": "24.13.3",
    "kysely": "0.29.3",
    "oxfmt": "0.59.0",
    "perf_hooks": "0.0.1",
    "typescript": "6.0.3",
    "vitest": "3.2.6"
  },
  "peerDependencies": {
    "@aws-sdk/client-rds-data": "3.x",
    "kysely": ">=0.28.0 <0.30.0"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist"
  ]
}
